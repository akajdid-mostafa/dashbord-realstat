# Local development values (safe, non-secret).
# Full env file is NOT committed. Secrets stay in gitignored .env / .env.local only.

# Client (NEXT_PUBLIC_*) — configuration, not secrets. In production these are set
# per Vercel environment; locally use localhost origins.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_LOG_LEVEL=info
NEXT_PUBLIC_OPENCAGE_API_KEY=

# Server-only (backend). Never prefix with NEXT_PUBLIC_ or they ship to the browser.
# In production these live in the dashboard Vercel project (production/preview).
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
JWT_SECRET=
CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
